# Backend
DB_HOST=localhost
DB_PORT=3307
DB_HOST_PORT=3307
DB_NAME=college_recommendation
DB_USER=zhiyuan
# Sample credentials for local development only. Change them for any shared deployment.
DB_PASSWORD=zhiyuan123
MYSQL_ROOT_PASSWORD=zhiyuan_root_2026
DB_SCHEMA_INIT_MODE=always
SERVER_PORT=8080
SERVER_HOST_PORT=8080
AUTH_TOKEN_TTL_SECONDS=86400
# Required, no default. Must decode to >= 32 bytes of key material.
# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=zhiyuan
# Set to true only for local demos that still rely on the clear-text seed passwords
# in sql/data.sql. Keep false everywhere else.
AUTH_ALLOW_LEGACY_PLAINTEXT_LOGIN=false

# API documentation (OpenAPI/Swagger). Off by default: the document lists every
# admin endpoint. Both flags must be true to reach /swagger-ui.html.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
SECURITY_EXPOSE_API_DOCS=false
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/v3/api-docs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=3s
# The compose stack ships Redis, so token revocation and caches are shared across
# instances. Only set this to false when running the jar without Redis.
CACHE_REDIS_ENABLED=true
CACHE_RECOMMENDATION_TTL=10m
CACHE_META_TTL=30m

# RocketMQ
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=rocketmq-nameserver:9876
ROCKETMQ_NAMESERVER_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_FAST_REMOTING_HOST_PORT=10909
ROCKETMQ_HA_HOST_PORT=10912
ROCKETMQ_RECOMMENDATION_TOPIC=recommendation-task-topic
ROCKETMQ_RECOMMENDATION_TAG=free-text
ROCKETMQ_PRODUCER_GROUP=recommendation-task-producer-group
ROCKETMQ_CONSUMER_GROUP=recommendation-task-consumer-group
ROCKETMQ_SEND_TIMEOUT_MS=3000
ROCKETMQ_PRODUCER_RETRY_TIMES=2
ROCKETMQ_RUNNING_TIMEOUT=5m

# AI
QWEN_ENABLED=false
QWEN_BASE_URL=https://api.deepseek.com
QWEN_MODEL=deepseek-v4-flash
QWEN_API_KEY=
QWEN_RETRY_MAX_ATTEMPTS=3
QWEN_RETRY_BACKOFF_MILLIS=150
QWEN_TIMEOUT_CONNECT_MILLIS=5000
QWEN_TIMEOUT_READ_MILLIS=30000
